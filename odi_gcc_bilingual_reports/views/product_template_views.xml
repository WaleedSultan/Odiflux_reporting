<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_odi_gcc_bilingual" model="ir.ui.view">
        <field name="name">product.template.form.odi.gcc.bilingual</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="name_ar" placeholder="اسم المنتج بالعربية"/>
            </xpath>
        </field>
    </record>
</odoo>
