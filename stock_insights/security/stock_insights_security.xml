<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Module Category (shown in Settings > Users) -->
        <record id="module_category_stock_insights" model="ir.module.category">
            <field name="name">Stock Insights</field>
            <field name="description">Access rights for Stock Insights reporting module</field>
            <field name="sequence">50</field>
        </record>

        <!-- Odoo 19: category lives on privilege, not on res.groups -->
        <record id="res_groups_privilege_stock_insights" model="res.groups.privilege">
            <field name="name">Stock Insights</field>
            <field name="description">Access rights for Stock Insights reporting module</field>
            <field name="sequence">50</field>
            <field name="category_id" ref="module_category_stock_insights"/>
        </record>

        <!-- Security Groups -->
        <record id="group_stock_insights_analyst" model="res.groups">
            <field name="name">Analyst</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_stock_insights"/>
            <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
            <field name="comment">Read-only access to all Stock Insights reports and dashboards.</field>
        </record>

        <record id="group_stock_insights_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_stock_insights"/>
            <field name="implied_ids" eval="[(4, ref('stock_insights.group_stock_insights_analyst'))]"/>
            <field name="comment">Full access to Stock Insights including configuration settings.</field>
        </record>

    </data>

    <data noupdate="1">
        
        <!-- Multi-company Record Rules -->
        <record id="stock_insights_config_company_rule" model="ir.rule">
            <field name="name">Stock Insights Config: multi-company</field>
            <field name="model_id" ref="model_stock_insights_config"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="stock_aging_report_company_rule" model="ir.rule">
            <field name="name">Stock Aging Report: multi-company</field>
            <field name="model_id" ref="model_stock_aging_report"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="stock_abc_report_company_rule" model="ir.rule">
            <field name="name">Stock ABC Report: multi-company</field>
            <field name="model_id" ref="model_stock_abc_report"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="stock_kpi_company_rule" model="ir.rule">
            <field name="name">Stock KPI: multi-company</field>
            <field name="model_id" ref="model_stock_kpi"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="stock_kpi_product_company_rule" model="ir.rule">
            <field name="name">Stock KPI Product: multi-company</field>
            <field name="model_id" ref="model_stock_kpi_product"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="stock_coverage_report_company_rule" model="ir.rule">
            <field name="name">Stock Coverage Report: multi-company</field>
            <field name="model_id" ref="model_stock_coverage_report"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

    </data>
</odoo>
